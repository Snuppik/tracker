# Скопируйте в .env и заполните секреты: cp .env.example .env

PORT=8080

# Обязательно. Внутри docker compose хост — postgres, снаружи — localhost.
DATABASE_URL=postgres://tracker:tracker@localhost:5432/tracker?sslmode=disable

# Обязательно. Сгенерировать: openssl rand -hex 32
JWT_SECRET=

# dev | production
ENV=dev

# Переопределяет Secure у cookie. Пусто = (ENV == production).
COOKIE_SECURE=

# Web Push (опционально). Без ключей push отключён, in-app лента работает.
# Сгенерировать: go run ./cmd/genvapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:demo@tracker.local

REMINDER_TICK_SECONDS=30
REMINDER_GRACE_MINUTES=10

LOG_LEVEL=info

# --- Параметры docker compose (читаются самим compose, в приложение не попадают) ---

# Реквизиты PostgreSQL. На сервере задайте свой пароль.
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=tracker

# Домен для Caddy и Let's Encrypt. Пусто = localhost (локальная проверка без DNS).
TRACKER_DOMAIN=

# Интерфейс и порт, на котором публикуется API. 127.0.0.1 = только через Caddy.
# Если панель провайдера уже занимает 80/443, поменяйте TRACKER_HTTP_PORT/TRACKER_HTTPS_PORT.
TRACKER_API_HOST=127.0.0.1
TRACKER_API_PORT=8080
TRACKER_HTTP_PORT=80
TRACKER_HTTPS_PORT=443
